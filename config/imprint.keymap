#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,matrix-transform = &imprint_function_row_full_bottom_row; };

    macros {
        Enter_TO2: Enter_TO2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ENTER &to 2>;
            label = "ENTER_TO2";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC       &kp F1  &kp F2          &kp F3           &kp F4         &kp F5                       &kp F6     &kp F7     &kp F8        &kp F9          &kp F10   &kp F11
&kp TILDE     &kp N1  &kp N2          &kp N3           &kp N4         &kp N5                       &kp N6     &kp N7     &kp N8        &kp N9          &kp N0    &kp EQUAL
&kp CAPS      &kp Q   &kp W           &kp E            &kp R          &kp T                        &kp Y      &kp U      &kp I         &kp O           &kp P     &kp MINUS
&kp TAB       &kp A   &kp S           &kp D            &kp F          &kp G                        &kp H      &kp J      &kp K         &kp L           &kp SEMI  &kp SQT
&kp LEFT_ALT  &kp Z   &kp X           &kp C            &kp V          &kp B                        &kp N      &kp M      &kp COMMA     &kp DOT         &kp FSLH  &kp RIGHT_ALT
&trans        &trans  &kp LEFT_ARROW  &kp RIGHT_ARROW  &trans                                                 &trans     &kp UP_ARROW  &kp DOWN_ARROW  &trans    &trans
                                                       &to 3          &kp ENTER       &mo 5        &kp DEL    &kp ENTER  &to 0
                                                       &kp BACKSPACE  &kp LEFT_SHIFT  &kp LCTRL    &kp SPACE  &kp ENTER  &to 1
            >;
        };

        Game_Layer {
            bindings = <
&kp ESCAPE  &kp P      &kp Z           &kp X            &kp I   &kp M                        &kp C_PREV  &kp C_NEXT  &kp C_PLAY_PAUSE  &kp C_VOL_DN    &kp C_VOL_UP  &bl BL_ON
&kp J       &none      &none           &none            &kp T   &kp O                        &trans      &trans      &trans            &trans          &trans        &bl BL_OFF
&kp K       &kp SPACE  &kp Q           &kp W            &kp E   &kp R                        &kp Y       &kp U       &kp I             &kp O           &kp P         &trans
&kp SPACE   &kp SPACE  &kp A           &kp S            &kp D   &kp F                        &kp H       &kp J       &kp K             &kp L           &trans        &trans
&kp L       &kp LCTRL  &none           &kp C            &none   &none                        &kp N       &kp M       &trans            &trans          &trans        &trans
&trans      &trans     &kp LEFT_ARROW  &kp RIGHT_ARROW  &trans                                           &trans      &kp UP_ARROW      &kp DOWN_ARROW  &trans        &trans
                                                        &kp B   &kp T           &kp TAB      &kp DEL     &kp ENTER   &to 0
                                                        &kp C   &kp LEFT_SHIFT  &kp LCTRL    &kp SPACE   &trans      &to 2
            >;
        };

        CAD_Layer {
            bindings = <
&kp ESC       &kp I   &kp O           &kp P            &kp J          &kp N                        &kp F2     &kp F5     &kp F8        &kp F9          &kp F10   &kp F11
&kp TILDE     &kp N1  &kp N2          &kp N3           &kp Y          &kp U                        &kp N6     &kp N7     &kp N8        &kp N9          &kp N0    &kp EQUAL
&kp CAPS      &kp Q   &kp W           &kp E            &kp R          &kp T                        &kp Y      &kp U      &kp I         &kp O           &kp P     &kp MINUS
&kp TAB       &kp A   &kp S           &kp D            &kp F          &kp G                        &kp H      &kp J      &kp K         &kp L           &kp SEMI  &kp SQT
&kp LEFT_ALT  &kp Z   &kp X           &kp C            &kp V          &kp B                        &kp N      &kp M      &kp COMMA     &kp DOT         &kp FSLH  &kp RIGHT_ALT
&trans        &trans  &kp LEFT_ARROW  &kp RIGHT_ARROW  &trans                                                 &trans     &kp UP_ARROW  &kp DOWN_ARROW  &trans    &trans
                                                       &tog 3         &kp ENTER       &mo 5        &kp DEL    &kp ENTER  &to 0
                                                       &kp BACKSPACE  &kp LEFT_SHIFT  &kp LCTRL    &kp SPACE  &kp PG_UP  &to 3
            >;
        };

        Numpad {
            bindings = <
&kp ESCAPE  &to 0            &kp F2          &trans           &kp F4         &trans                        &trans  &trans  &trans        &trans    &trans  &trans
&trans      &trans           &trans          &trans           &trans         &trans                        &trans  &trans  &trans        &trans    &trans  &trans
&kp PLUS    &kp KP_SUBTRACT  &kp NUMBER_7    &kp N8           &kp N9         &kp KP_MULTIPLY               &trans  &trans  &trans        &trans    &trans  &trans
&trans      &kp PERIOD       &kp NUMBER_4    &kp N5           &kp NUMBER_6   &kp KP_SLASH                  &trans  &trans  &trans        &trans    &trans  &trans
&trans      &kp COMMA        &kp NUMBER_1    &kp NUMBER_2     &kp NUMBER_3   &kp EQUAL                     &trans  &trans  &trans        &trans    &trans  &trans
&trans      &trans           &kp LEFT_ARROW  &kp RIGHT_ARROW  &trans                                               &trans  &kp UP_ARROW  &kp DOWN  &trans  &trans
                                                              &to 2          &Enter_TO2       &mo 5        &trans  &trans  &to 0
                                                              &kp BACKSPACE  &kp N0           &kp LCTRL    &trans  &trans  &to 4
            >;
        };

        Keyboard_Control_Layer {
            bindings = <
&trans       &trans        &trans        &trans        &trans        &trans                  &trans           &trans           &trans           &trans           &trans           &trans
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans           &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &trans           &trans           &trans
&sys_reset   &trans        &trans        &trans        &trans        &trans                  &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &sys_reset
&bootloader  &trans        &trans        &trans        &trans        &trans                  &trans           &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &bootloader
&to 2        &trans        &trans        &trans        &trans        &trans                  &trans           &trans           &trans           &trans           &trans           &to 2
&to 2        &trans        &trans        &trans        &trans                                                 &trans           &trans           &trans           &trans           &to 2
                                                       &trans        &trans        &trans    &trans           &trans           &trans
                                                       &trans        &trans        &trans    &trans           &trans           &trans
            >;
        };

        Modifier {
            bindings = <
&trans    &trans            &trans                &trans                 &trans           &trans               &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans            &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans           &trans               &trans  &trans  &trans  &trans  &trans  &trans
&kp PLUS  &kp MINUS         &kp BACKSLASH         &kp SLASH              &kp KP_MULTIPLY  &kp PG_UP            &trans  &trans  &trans  &trans  &trans  &trans
&trans    &kp UNDER         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION     &kp PG_DN            &trans  &trans  &trans  &trans  &trans  &trans
&trans    &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp LC(C)              &kp LC(V)        &trans               &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans            &kp LEFT_WIN          &kp PSCRN              &trans                                        &trans  &trans  &trans  &trans  &trans
                                                                         &trans           &trans     &trans    &trans  &trans  &trans
                                                                         &trans           &trans     &trans    &trans  &trans  &trans
            >;
        };
    };
};

// right hand trackball configuration
// &trackball_peripheral_listener {
//    input-processors =
//     activate layer 3 within 500ms of the trackball moving
//     <&zip_temp_layer 3 500>;
// };
//left hand trackball configuration

&trackball_central_listener {
    input-processors =
        // multiply sensitivity by 1, divide by 3 (make it slower for scrolling),,,,,,,,,,,,,,
        <&zip_xy_scaler 1 3>,
        // make this trackball output scrolling events by default instead of cursor movement,,,,,,,,,,,,,,
        <&zip_xy_to_scroll_mapper>,
        // invert vertical scrolling so that the view moves in the same direction as the top of the trackball.,,,,,,,,,,,,,,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
